{
  "$id": "https://raw.githubusercontent.com/inaku-Gyan/inclean/main/schemas/inclean.toml.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "inclean.toml",
  "description": "Configuration schema for inclean. See https://github.com/inaku-Gyan/inclean/blob/main/docs/configuration.md",
  "type": "object",
  "properties": {
    "project": {
      "$ref": "#/$defs/RawProject"
    },
    "rule": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RawRule"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "project"
  ],
  "$defs": {
    "RawProject": {
      "description": "The `[project]` block.",
      "type": "object",
      "properties": {
        "root": {
          "description": "Project root, relative to the config file's directory.\nDefaults to `\".\"` (the config's own directory).\nMust be a literal path, not a glob.",
          "type": "string",
          "default": "."
        },
        "version": {
          "description": "CLI version that wrote this config.",
          "type": "string"
        },
        "min_inclean_version": {
          "description": "Minimum CLI version that can parse this config.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "min_inclean_version"
      ]
    },
    "RawRule": {
      "description": "A single `[[rule]]` entry, before defaulting / copy / constant expansion.\n`Option<_>` distinguishes \"user did not specify\" from \"user wrote empty\".",
      "type": "object",
      "properties": {
        "name": {
          "description": "Globally unique across the config.",
          "type": "string"
        },
        "copied_from": {
          "description": "Name of a previously declared rule whose resolved fields are copied\n(transitively) into this one. Top-level fields the child sets are\nkept; top-level fields the child omits inherit from the parent's\nresolved value. Inner fields of an object the child rewrites default\nto null/disabled — use `${copied}` to pull each inner field from the\nparent explicitly.",
          "type": [
            "string",
            "null"
          ]
        },
        "file_paths": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "file_suffixes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "suppression_comments_regex": {
          "description": "The whole field can also be the string `\"${copied}\"` to reuse the\nparent rule's resolved value verbatim (object-context `${copied}`).",
          "anyOf": [
            {
              "$ref": "#/$defs/RawSuppression"
            },
            {
              "type": "null"
            }
          ]
        },
        "match_forms": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/IncludeForm"
          }
        },
        "include_match": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "include_directories": {
          "description": "Literal directory paths under the project root (relative to it) that\nthe `resolve` action probes to locate the include's actual header.\nNOT a glob; no implicit `/**` suffix; no `.gitignore` semantics.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "action": {
          "description": "The whole field can also be the string `\"${copied}\"` to reuse the\nparent rule's resolved action verbatim (object-context `${copied}`).",
          "anyOf": [
            {
              "$ref": "#/$defs/RawAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "trailing_comment": {
          "description": "The whole field can also be the string `\"${copied}\"` to reuse the\nparent rule's resolved value verbatim (object-context `${copied}`).",
          "anyOf": [
            {
              "$ref": "#/$defs/RawTrailingComment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "RawSuppression": {
      "description": "Suppression markers: regex patterns matched line-by-line.",
      "type": "object",
      "properties": {
        "block_start": {
          "type": [
            "string",
            "null"
          ]
        },
        "block_end": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "IncludeForm": {
      "description": "Which \"form\" of `#include` a rule applies to.",
      "oneOf": [
        {
          "description": "`#include \"foo.h\"`",
          "type": "string",
          "const": "quote"
        },
        {
          "description": "`#include <foo.h>`",
          "type": "string",
          "const": "angle"
        },
        {
          "description": "`#include MY_HEADER` (macro-defined). Matching this form is allowed\nin config; in v1 evaluation of an action against a macro #include\nalways produces an error.",
          "type": "string",
          "const": "macro"
        }
      ]
    },
    "RawAction": {
      "description": "The action a rule executes on a matched `#include`. Tagged by `type`.",
      "oneOf": [
        {
          "description": "Resolve the include against the rule's `include_directories`, then\nrewrite the path to be relative to `relative_to`.",
          "type": "object",
          "properties": {
            "relative_to": {
              "type": "string"
            },
            "output_form": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OutputForm"
                },
                {
                  "type": "null"
                }
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "resolve"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "relative_to"
          ]
        },
        {
          "description": "Replace the include text with `with`, supporting `${...}` placeholders.",
          "type": "object",
          "properties": {
            "with": {
              "type": "string"
            },
            "output_form": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OutputForm"
                },
                {
                  "type": "null"
                }
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "replace"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "with"
          ]
        },
        {
          "description": "Leave the include's argument alone (the form may still change via\n`output_form`).",
          "type": "object",
          "properties": {
            "output_form": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OutputForm"
                },
                {
                  "type": "null"
                }
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "keep"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Delete the entire `#include` line.",
          "type": "object",
          "properties": {
            "keep_blank_line": {
              "type": [
                "boolean",
                "null"
              ],
              "default": null
            },
            "keep_trailing_comment": {
              "type": [
                "boolean",
                "null"
              ],
              "default": null
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "remove"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Wrap the include line in `//` (default) or `/* */` delimiters.",
          "type": "object",
          "properties": {
            "style": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CommentStyle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "comment_out"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Report a user-facing error for the matched include. Exit code 2.",
          "type": "object",
          "properties": {
            "message": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "error"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "OutputForm": {
      "description": "Output form for the include's delimiters after a rule fires.",
      "oneOf": [
        {
          "description": "`#include \"...\"`",
          "type": "string",
          "const": "quote"
        },
        {
          "description": "`#include <...>`",
          "type": "string",
          "const": "angle"
        },
        {
          "description": "Keep whatever form the original `#include` used.",
          "type": "string",
          "const": "preserve"
        }
      ]
    },
    "CommentStyle": {
      "description": "Trailing-comment delimiter style.",
      "oneOf": [
        {
          "description": "`// ...`",
          "type": "string",
          "const": "//"
        },
        {
          "description": "`/* ... */`",
          "type": "string",
          "const": "/**/"
        }
      ]
    },
    "RawTrailingComment": {
      "description": "Trailing-comment configuration.",
      "type": "object",
      "properties": {
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawTrailingTransform"
            },
            {
              "type": "null"
            }
          ]
        },
        "append_if_absent": {
          "description": "Literal text to append to the include line when there is no\ntrailing comment after action evaluation. The user writes the full\ncomment text (including delimiters and leading whitespace).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "RawTrailingTransform": {
      "description": "Trailing-comment transform: matches an existing comment, then runs an\naction over it. `action` is required — per refactor.md §\"Config File\"\nthe schema lists it without a `?`, and silent defaulting to `Keep`\nhides config bugs.",
      "type": "object",
      "properties": {
        "match_styles": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/CommentStyle"
          }
        },
        "content_regex": {
          "type": [
            "string",
            "null"
          ]
        },
        "action": {
          "$ref": "#/$defs/RawTrailingAction"
        }
      },
      "additionalProperties": false,
      "required": [
        "action"
      ]
    },
    "RawTrailingAction": {
      "description": "The action a trailing-comment transform runs on its match.",
      "oneOf": [
        {
          "description": "Replace the comment body with `with`.",
          "type": "object",
          "properties": {
            "with": {
              "type": "string"
            },
            "output_style": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OutputCommentStyle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "replace"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "with"
          ]
        },
        {
          "description": "Keep the comment body; only `output_style` may change.",
          "type": "object",
          "properties": {
            "output_style": {
              "anyOf": [
                {
                  "$ref": "#/$defs/OutputCommentStyle"
                },
                {
                  "type": "null"
                }
              ]
            },
            "message": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "keep"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Remove the trailing comment entirely.",
          "type": "object",
          "properties": {
            "message": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "remove"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "description": "Report a user-facing error when the transform matches.",
          "type": "object",
          "properties": {
            "message": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "error"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "OutputCommentStyle": {
      "description": "Trailing-comment output style with an extra `preserve` variant for\n`trailing_comment.transform.action.output_style`.",
      "oneOf": [
        {
          "description": "`// ...`",
          "type": "string",
          "const": "//"
        },
        {
          "description": "`/* ... */`",
          "type": "string",
          "const": "/**/"
        },
        {
          "description": "Keep whatever delimiter the original trailing comment used.",
          "type": "string",
          "const": "preserve"
        }
      ]
    }
  }
}
